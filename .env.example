# ==============================================================================
# Assistente de IA do painel (job-pindorama)
#
# COMO USAR:
# 1. Copie este arquivo para `.env`:
#      cp .env.example .env
# 2. Escolha o seu provedor em `AI_PROVIDER=` (openai, gemini ou claude).
# 3. Preencha a chave de API correspondente abaixo, OU use a CLI local
#    (Codex, Antigravity agy ou Claude Code) já instalada no PATH do seu sistema.
# 4. Alternativamente, você pode configurar tudo visualmente abrindo o painel
#    (`python tools/painel.py`) na aba "Configurações".
#
# AVISO DE PRIVACIDADE:
# Defina AI_DATA_CONSENT=yes para permitir que o painel envie descrições de vagas
# e o seu resumo profissional (sem CPF, RG, CNPJ ou endereço) para o provedor.
#
# NUNCA adicione chaves reais neste arquivo (.env.example vai para o git).
# O arquivo .env fica no .gitignore e nunca é versionado.
# ==============================================================================

# Provedor ativo: openai, gemini, claude (ou auto).
# Se deixado em branco, você pode configurar pela aba Configurações do painel.
AI_PROVIDER=

# Confirmação de privacidade (necessário "yes" para usar a IA)
AI_DATA_CONSENT=

# ------------------------------------------------------------------------------
# 1. OpenAI / ChatGPT / Codex
# Obtenha sua chave em: https://platform.openai.com/api-keys
# OPENAI_BASE_URL (opcional) aponta para um servidor compatível com a API da OpenAI,
# por exemplo Ollama (http://localhost:11434/v1) ou OpenRouter (https://openrouter.ai/api/v1).
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Google Gemini
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 3. Anthropic Claude
# Obtenha sua chave em: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
